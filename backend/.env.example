APP_NAME=Research2Code
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120

# Only enable once TLS termination (reverse proxy/load balancer) is confirmed.
HSTS_ENABLED=false

OTEL_ENABLED=false
OTEL_SERVICE_NAME=research2code-api
OTEL_EXPORTER_OTLP_ENDPOINT=

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=research2code
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5.0

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword
NEO4J_CONNECTION_TIMEOUT_SECONDS=10.0
NEO4J_MAX_CONNECTION_POOL_SIZE=50

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=research2code
MINIO_SECURE=false
MINIO_CONNECT_TIMEOUT_SECONDS=10
MINIO_READ_TIMEOUT_SECONDS=60

MAX_PDF_SIZE_MB=50
MAX_IMAGE_SIZE_MB=10

TESSERACT_CMD=
OCR_MIN_TEXT_LENGTH=20
OCR_RENDER_DPI=200
OCR_LANGUAGE=eng

LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
LLM_TEMPERATURE=0.0
LLM_MAX_INPUT_CHARS=60000
LLM_REQUEST_TIMEOUT_SECONDS=120
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_REQUEST_TIMEOUT_SECONDS=60

RAG_CONTEXT_TOKEN_BUDGET=3000
RAG_CACHE_TTL_SECONDS=900
RAG_RRF_K=60
RAG_DEFAULT_LIMIT=10

# DOCKER_HOST left unset uses the local daemon socket (/var/run/docker.sock,
# mounted into the celery_worker container - see docker-compose.yml).
DOCKER_HOST=
EXECUTION_WORK_ROOT=/tmp/research2code/executions
# Must be the *host's* absolute path backing that same bind mount - see the
# settings.py docstring for why. docker-compose.yml sets this from $PWD.
EXECUTION_HOST_WORK_ROOT=
EXECUTION_NETWORK_DISABLED=false
EXECUTION_CPU_LIMIT=2.0
EXECUTION_MEMORY_LIMIT_MB=4096
EXECUTION_TIMEOUT_SECONDS=21600
EXECUTION_MONITOR_INTERVAL_SECONDS=10
EXECUTION_LOG_TAIL_LINES=5000

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

TENSORBOARD_LOG_ROOT=/tmp/research2code/tensorboard_logs
TENSORBOARD_HOST_LOG_ROOT=
TENSORBOARD_BASE_URL=http://localhost:6006

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
