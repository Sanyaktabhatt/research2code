model:
  name: "{{ model_name }}"
  num_classes: {{ num_classes }}

data:
  dataset_name: "{{ dataset_name }}"
  data_dir: "./data"
  batch_size: {{ batch_size }}
  num_workers: 4

training:
  seed: 42
  epochs: {{ epochs }}
  batch_size: {{ batch_size }}
  checkpoint_dir: "checkpoints"
  log_dir: "runs"
  experiment_name: "{{ project_name }}"
{% if options.early_stopping %}
  early_stopping_patience: 10
{% endif %}

optimizer:
  name: "{{ optimizer_name }}"
  learning_rate: {{ learning_rate }}
  weight_decay: {{ weight_decay }}

scheduler:
  name: "{{ scheduler_name }}"

{% if hyperparameters %}
# Additional hyperparameters extracted from the paper (informational -
# wire these into model.py/losses.py/etc. as needed):
extracted_hyperparameters:
{% for hp in hyperparameters %}
  {{ hp.name }}: "{{ hp.value }}"
{% endfor %}
{% endif %}
