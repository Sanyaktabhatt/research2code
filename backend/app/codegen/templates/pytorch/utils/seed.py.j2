import os
import random

import numpy as np
import torch


def set_seed(seed: int) -> None:
    """Seeds every RNG that affects reproducibility (Python, NumPy, PyTorch/CUDA)."""
    os.environ["PYTHONHASHSEED"] = str(seed)
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)
